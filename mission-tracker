#!/bin/bash
# 🛸 ORBIT - Mission Tracker
# Real-time monitoring of orbital operations
# "Ground Control to Major Tom..." 🎵

cd "$(dirname "$0")"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

print_header() {
    clear
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  📡 ORBIT - Mission Tracker                                   ║${NC}"
    echo -e "${MAGENTA}║     Ground Control Monitoring Station                         ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

show_status() {
    print_header
    
    echo -e "${CYAN}=== 📦 Cargo Bay Status ===${NC}"
    if [ -f ".copilot/cargo_manifest.txt" ]; then
        local total=$(grep "^[^#]" .copilot/cargo_manifest.txt | grep -v "^$" | wc -l)
        local delivered=$(grep "^# ✓" .copilot/cargo_manifest.txt | wc -l)
        
        echo -e "Total cargo: ${BLUE}$((total + delivered))${NC}"
        echo -e "Delivered: ${GREEN}$delivered${NC}"
        echo -e "Pending: ${YELLOW}$total${NC}"
    else
        echo "  No cargo manifest"
    fi
    
    echo ""
    echo -e "${CYAN}=== 🚀 Current Mission ===${NC}"
    if [ -f ".copilot/state/mission.log" ]; then
        tail -3 .copilot/state/mission.log | head -1
    else
        echo "No active mission"
    fi
    
    echo ""
    echo -e "${CYAN}=== 📡 Recent Transmissions (last 10) ===${NC}"
    if [ -f ".copilot/state/mission.log" ]; then
        tail -10 .copilot/state/mission.log
    fi
    
    echo ""
    echo -e "${CYAN}=== 📂 Log Files ===${NC}"
    echo "Mission:    .copilot/state/mission.log"
    echo "Cargo:      .copilot/state/cargo.log"
    echo "Flight Log: .copilot/state/flight_log.md"
    echo "HAL:        .copilot/state/hal.log"
    
    echo ""
    echo -e "${YELLOW}Press Ctrl+C to exit, or wait 5s for refresh...${NC}"
}

case "${1:-status}" in
    tail|follow|f)
        echo -e "${CYAN}📡 Following mission log (Ctrl+C to exit)...${NC}"
        echo ""
        tail -f .copilot/state/mission.log 2>/dev/null || echo "No log file yet"
        ;;
    cargo|c)
        echo -e "${CYAN}📦 Following cargo log (Ctrl+C to exit)...${NC}"
        echo ""
        tail -f .copilot/state/cargo.log 2>/dev/null || echo "No log file yet"
        ;;
    flight|log|l)
        cat .copilot/state/flight_log.md 2>/dev/null || echo "No flight log yet"
        ;;
    hal|h)
        echo -e "${CYAN}🤖 HAL Status:${NC}"
        cat .copilot/state/hal.log 2>/dev/null || echo "HAL is dormant"
        ;;
    watch|w)
        while true; do
            show_status
            sleep 5
        done
        ;;
    *)
        show_status
        ;;
esac
