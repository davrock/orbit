#!/bin/bash
# Open the Orchestrator Dashboard
# Starts a simple HTTP server and opens browser

cd "$(dirname "$0")"

PORT=${1:-8080}

echo "╔════════════════════════════════════════════════╗"
echo "║   Copilot Orchestrator Dashboard               ║"
echo "╚════════════════════════════════════════════════╝"
echo ""

# Check if metrics.json exists
if [ ! -f ".copilot/metrics.json" ]; then
    echo "Note: No metrics.json found yet."
    echo "Run some orchestrations first, or load a file in the dashboard."
    echo ""
fi

# Find available server
if command -v python3 &>/dev/null; then
    echo "Starting server at http://localhost:$PORT"
    echo "Dashboard: http://localhost:$PORT/.copilot/dashboard/"
    echo ""
    echo "Press Ctrl+C to stop"
    echo ""
    
    # Try to open browser
    if command -v xdg-open &>/dev/null; then
        (sleep 1 && xdg-open "http://localhost:$PORT/.copilot/dashboard/") &
    elif command -v open &>/dev/null; then
        (sleep 1 && open "http://localhost:$PORT/.copilot/dashboard/") &
    fi
    
    python3 -m http.server $PORT
    
elif command -v php &>/dev/null; then
    echo "Starting PHP server at http://localhost:$PORT"
    echo "Dashboard: http://localhost:$PORT/.copilot/dashboard/"
    echo ""
    
    if command -v xdg-open &>/dev/null; then
        (sleep 1 && xdg-open "http://localhost:$PORT/.copilot/dashboard/") &
    elif command -v open &>/dev/null; then
        (sleep 1 && open "http://localhost:$PORT/.copilot/dashboard/") &
    fi
    
    php -S localhost:$PORT
    
elif command -v npx &>/dev/null; then
    echo "Starting Node server at http://localhost:$PORT"
    echo "Dashboard: http://localhost:$PORT/.copilot/dashboard/"
    echo ""
    
    if command -v xdg-open &>/dev/null; then
        (sleep 1 && xdg-open "http://localhost:$PORT/.copilot/dashboard/") &
    elif command -v open &>/dev/null; then
        (sleep 1 && open "http://localhost:$PORT/.copilot/dashboard/") &
    fi
    
    npx serve -l $PORT
    
else
    echo "No HTTP server available (python3, php, or npx)"
    echo ""
    echo "You can open the dashboard directly in your browser:"
    echo "  file://$(pwd)/.copilot/dashboard/index.html"
    echo ""
    echo "Or install Python 3: apt install python3"
fi
