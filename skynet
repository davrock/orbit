#!/bin/bash
# 🤖 SKYNET - Autonomous Development Orchestrator
# "I'll be back... with better code" - The Terminator
# AI-powered software development with specialized agents
# Features: Model selection, best practices injection, cost optimization

set -e
cd "$(dirname "$0")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# Load config
[ -f ".copilot/config.sh" ] && source .copilot/config.sh

# Defaults
PROJECT_NAME="${PROJECT_NAME:-$(basename "$(pwd)")}"
MAX_RETRIES="${MAX_RETRIES:-2}"
GIT_BRANCH="${GIT_BRANCH:-development}"
GIT_AUTO_PUSH="${GIT_AUTO_PUSH:-true}"

# Timeouts (seconds)
TIMEOUT_DEFAULT="${TIMEOUT_DEFAULT:-600}"

# Model selection (can override via env)
MODEL_TIER="${MODEL_TIER:-auto}"  # auto, premium, standard, fast

# Validation
REQUIRE_TYPE_CHECK="${REQUIRE_TYPE_CHECK:-true}"
REQUIRE_TESTS_PASS="${REQUIRE_TESTS_PASS:-true}"
TYPE_CHECK_CMD="${TYPE_CHECK_CMD:-npx tsc --noEmit}"
TEST_CMD="${TEST_CMD:-npm test}"
MIN_FILES_CHANGED="${MIN_FILES_CHANGED:-1}"

# State
STATE_DIR=".copilot/state"
HANDOFF_FILE="$STATE_DIR/handoff.md"
LOG_FILE="$STATE_DIR/skynet.log"
COST_FILE="$STATE_DIR/cost_tracking.json"

# Parse flags
DRY_RUN=false
INTERACTIVE=false
RESUME=false
LIST_AGENTS=false
LIST_WORKFLOWS=false
SHOW_HELP=false
CUSTOM_WORKFLOW=""
CUSTOM_AGENT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --interactive|-i) INTERACTIVE=true; shift ;;
        --resume) RESUME=true; shift ;;
        --workflow) shift; CUSTOM_WORKFLOW="$1"; shift ;;
        --agent) shift; CUSTOM_AGENT="$1"; shift ;;
        --agents) LIST_AGENTS=true; shift ;;
        --workflows) LIST_WORKFLOWS=true; shift ;;
        --help|-h) SHOW_HELP=true; shift ;;
        --metrics) show_metrics; exit 0 ;;
        --costs) show_costs; exit 0 ;;
        --model) shift; MODEL_TIER="$1"; shift ;;
        --cheap) MODEL_TIER=fast; shift ;;
        --premium) MODEL_TIER=premium; shift ;;
        *) break ;;
    esac
done

# Handle custom workflow mode
if [ -n "$CUSTOM_WORKFLOW" ]; then
    WORKFLOW="custom"
    TASK="$*"
else
    WORKFLOW="${1:-}"
    shift 2>/dev/null || true
    TASK="$*"
fi

mkdir -p "$STATE_DIR"

# === MODEL SELECTION ===

get_model_tier_for_task() {
    local task="$1"
    local phase="$2"
    
    # If explicitly set, use that
    [ "$MODEL_TIER" != "auto" ] && echo "$MODEL_TIER" && return
    
    # Check for premium keywords
    if echo "$task" | grep -qiE "security|vulnerability|architecture|redesign|performance.critical|production.bug"; then
        echo "premium"
        return
    fi
    
    # Check for fast keywords
    if echo "$task" | grep -qiE "typo|rename|comment|format|simple|minor|docs"; then
        echo "fast"
        return
    fi
    
    # Phase-based defaults
    case "$phase" in
        security) echo "premium" ;;
        document) echo "fast" ;;
        commit) echo "fast" ;;
        *) echo "standard" ;;
    esac
}

get_model_indicator() {
    local tier="$1"
    case "$tier" in
        premium) echo "🔥" ;;
        standard) echo "⚡" ;;
        fast) echo "💨" ;;
        *) echo "⚡" ;;
    esac
}

track_cost() {
    local tier="$1"
    local multiplier=1.0
    case "$tier" in
        premium) multiplier=3.0 ;;
        standard) multiplier=1.0 ;;
        fast) multiplier=0.5 ;;
    esac
    
    if command -v python3 &>/dev/null; then
        python3 << EOF
import json, os
f = '$COST_FILE'
try:
    d = json.load(open(f)) if os.path.exists(f) else {'total': 0, 'by_tier': {}}
except: d = {'total': 0, 'by_tier': {}}
d['total'] = d.get('total', 0) + $multiplier
d['by_tier']['$tier'] = d.get('by_tier', {}).get('$tier', 0) + 1
json.dump(d, open(f, 'w'), indent=2)
EOF
    fi
}

# === BEST PRACTICES INJECTION ===

get_best_practices_for_agent() {
    local agent="$1"
    local practices=""
    
    if [ -f ".copilot/best-practices.yaml" ] && command -v python3 &>/dev/null; then
        practices=$(python3 << EOF
import yaml
try:
    with open('.copilot/best-practices.yaml') as f:
        bp = yaml.safe_load(f)
    ag = bp.get('agent_guidelines', {}).get('$agent', {})
    if isinstance(ag, list):
        print(' '.join(['- ' + x for x in ag[:5]]))
    else:
        print('')
except: pass
EOF
2>/dev/null)
    fi
    
    echo "$practices"
}

# === UTILITY FUNCTIONS ===

log() {
    echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

print_header() {
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🤖 SKYNET - ${PROJECT_NAME}                                  ${NC}"
    echo -e "${MAGENTA}║     \"I'll be back... with better code\"                       ${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_usage() {
    cat << 'EOF'
Usage: ./skynet [options] <workflow> "task description"

🚀 WORKFLOWS:
  ship-it      Full feature (plan → implement → test → review → commit)
  squash       Bug fix (debug → implement → test → commit)
  polish       Refactoring (implement → test → review → commit)
  yolo         Minimal (implement → commit)
  hotdog       Emergency hotfix (debug → implement → commit)
  test-first   TDD (test → implement → test → review → commit)
  fort-knox    Security-focused development
  endpoint     API development
  wordsmith    Documentation only
  
  Use --workflow <name> for custom workflows from .copilot/workflows.yaml

OPTIONS:
  --workflow <name>   Use custom workflow
  --agent <name>      Override agent (jarvis, neo, sherlock, etc.)
  --model <tier>      Force model tier (premium, standard, fast)
  --premium           Use premium models (3x tokens, complex tasks)
  --cheap             Use fast models (0.5x tokens, simple tasks)
  --dry-run           Show what would happen
  --interactive, -i   Confirm each phase
  --resume            Resume from checkpoint
  --agents            List available agents
  --workflows         List available workflows
  --metrics           Show metrics summary
  --costs             Show cost tracking
  --help, -h          Show this help

MODEL SELECTION (auto by default):
  🔥 premium   - Architecture, security, complex debugging (3x tokens)
  ⚡ standard  - General development, tests, reviews (1x tokens)
  💨 fast      - Docs, formatting, simple fixes (0.5x tokens)

EXAMPLES:
  ./skynet ship-it "add user authentication"
  ./skynet --cheap wordsmith "update README"
  ./skynet --premium fort-knox "security audit"
  ./skynet --dry-run squash "fix login crash"
EOF
}

show_costs() {
    echo -e "${CYAN}💰 Cost Tracking${NC}"
    if [ -f "$COST_FILE" ] && command -v python3 &>/dev/null; then
        python3 << 'EOF'
import json
try:
    d = json.load(open('.copilot/state/cost_tracking.json'))
    print(f"  Total token units: {d.get('total', 0):.1f}")
    print(f"  By tier:")
    for tier, count in d.get('by_tier', {}).items():
        mult = {'premium': 3.0, 'standard': 1.0, 'fast': 0.5}.get(tier, 1)
        print(f"    {tier}: {count} calls ({count * mult:.1f} units)")
except Exception as e:
    print(f"  No cost data yet")
EOF
    else
        echo "  No cost data yet"
    fi
}

list_agents() {
    echo -e "${CYAN}Available Agents:${NC}"
    echo ""
    if command -v python3 &>/dev/null && [ -f ".copilot/agents.yaml" ]; then
        python3 -c "
import yaml
with open('.copilot/agents.yaml') as f:
    data = yaml.safe_load(f)
for name, info in data.get('agents', {}).items():
    print(f'  {name:15} {info.get(\"description\", \"\")}')
" 2>/dev/null || echo "  (install pyyaml: pip install pyyaml)"
    else
        echo "  architect, implementer, tester, reviewer, debugger"
        echo "  security, performance, docs, devops, api, database"
        echo "  frontend, backend, mobile, planner, researcher"
    fi
}

list_workflows() {
    echo -e "${CYAN}Available Workflows:${NC}"
    echo ""
    if command -v python3 &>/dev/null && [ -f ".copilot/workflows.yaml" ]; then
        python3 -c "
import yaml
with open('.copilot/workflows.yaml') as f:
    data = yaml.safe_load(f)
for name, info in data.get('workflows', {}).items():
    phases = ' → '.join(info.get('phases', []))
    print(f'  {name:15} {phases}')
" 2>/dev/null || echo "  (install pyyaml: pip install pyyaml)"
    else
        echo "  feature, fix, refactor, quick, hotfix, tdd, secure, api, docs"
    fi
}

show_metrics() {
    if [ -f ".copilot/metrics.json" ] && command -v jq &>/dev/null; then
        local runs=$(jq '.runs | length' .copilot/metrics.json)
        local success=$(jq '[.runs[] | select(.status=="success")] | length' .copilot/metrics.json)
        echo -e "${CYAN}Metrics:${NC}"
        echo "  Total runs: $runs"
        echo "  Successful: $success"
        echo "  Success rate: $(( success * 100 / (runs > 0 ? runs : 1) ))%"
    else
        echo "No metrics available"
    fi
}

# === WORKFLOW FUNCTIONS ===

get_phases() {
    local workflow="$1"
    
    # Custom workflow from YAML
    if [ -n "$CUSTOM_WORKFLOW" ]; then
        if command -v python3 &>/dev/null && [ -f ".copilot/workflows.yaml" ]; then
            python3 -c "
import yaml
with open('.copilot/workflows.yaml') as f:
    data = yaml.safe_load(f)
w = data.get('workflows', {}).get('$CUSTOM_WORKFLOW', {})
print(' '.join(w.get('phases', [])))
" 2>/dev/null
            return
        fi
    fi
    
    # Built-in workflows (fun names)
    case "$workflow" in
        ship-it|feature)  echo "plan implement test review commit" ;;
        squash|fix)       echo "debug implement test commit" ;;
        polish|refactor)  echo "implement test review commit" ;;
        yolo|quick)       echo "implement commit" ;;
        hotdog|hotfix)    echo "debug implement commit" ;;
        test-first|tdd)   echo "test implement test review commit" ;;
        fort-knox|secure) echo "plan implement security test review commit" ;;
        endpoint|api)     echo "plan implement test document commit" ;;
        wordsmith|docs)   echo "implement review commit" ;;
        launch|deploy)    echo "test deploy commit" ;;
        explore|research) echo "research document" ;;
        inspect|analyze)  echo "review" ;;
        evolve|improve)   echo "analyze implement test commit" ;;
        paranoid)         echo "implement review test review commit" ;;
        turbo|perf)       echo "analyze implement test commit" ;;
        everything)       echo "research plan implement test security review document commit" ;;
        production)       echo "plan implement test security review test commit deploy" ;;
        *) echo "" ;;
    esac
}

