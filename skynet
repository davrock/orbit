# === PHASE EXECUTION ===

generate_phase_prompt() {
    local phase="$1"
    local agent=$(get_agent_for_phase "$phase")
    local agent_prompt=$(get_agent_prompt "$agent")
    local best_practices=$(get_best_practices_for_agent "$agent")
    local model_tier=$(get_model_tier_for_task "$TASK" "$phase")
    
    cat << EOF
$agent_prompt

TASK: $TASK
PHASE: $phase
WORKFLOW: $WORKFLOW

CONTEXT:
- Project: $PROJECT_NAME
- Handoff: $HANDOFF_FILE (read this first, update when done)
- Best Practices: .copilot/best-practices.yaml (reference for standards)
$( [ -n "$best_practices" ] && echo "- Agent Guidelines: $best_practices" )

EOF
    
    case "$phase" in
        plan)
            cat << EOF
Create an implementation plan:
1. Analyze requirements
2. Identify files to modify/create
3. List implementation steps
4. Note potential risks

Update handoff.md with your plan.
OUTPUT: "PLANNING COMPLETE" then /exit
EOF
            ;;
        implement)
            cat << EOF
Implement the planned changes:
1. Read the plan from handoff.md
2. Make the code changes
3. Follow existing patterns
4. Update handoff.md with what was done

OUTPUT: "IMPLEMENTATION COMPLETE" then /exit
EOF
            ;;
        test)
            cat << EOF
Create/run tests:
1. Add tests for new functionality
2. Run existing tests: $TEST_CMD
3. Fix any failures
4. Update handoff.md

OUTPUT: "TESTING COMPLETE" then /exit
EOF
            ;;
        review)
            cat << EOF
Review the changes:
1. Check code quality
2. Look for bugs
3. Verify best practices
4. Note any issues in handoff.md

OUTPUT: "REVIEW COMPLETE" then /exit
EOF
            ;;
        debug)
            cat << EOF
Debug the issue:
1. Reproduce the problem
2. Identify root cause
3. Plan the fix
4. Document in handoff.md

OUTPUT: "DEBUG COMPLETE" then /exit
EOF
            ;;
        security)
            cat << EOF
Security analysis:
1. Check for vulnerabilities
2. Review authentication/authorization
3. Check input validation
4. Note findings in handoff.md

OUTPUT: "SECURITY REVIEW COMPLETE" then /exit
EOF
            ;;
        commit)
            cat << EOF
Commit changes:
1. Stage: git add .
2. Commit with conventional message
3. Push to $GIT_BRANCH
4. Update handoff.md with commit SHA

OUTPUT: "COMMIT COMPLETE" then /exit
EOF
            ;;
        document)
            cat << EOF
Write documentation:
1. Update README if needed
2. Add inline comments
3. Document APIs
4. Update handoff.md

OUTPUT: "DOCUMENTATION COMPLETE" then /exit
EOF
            ;;
        *)
            echo "Complete the $phase phase and say '${phase^^} COMPLETE' then /exit"
            ;;
    esac
}

run_phase() {
    local phase="$1"
    local attempt="${2:-1}"
    local agent=$(get_agent_for_phase "$phase")
    local model_tier=$(get_model_tier_for_task "$TASK" "$phase")
    local model_icon=$(get_model_indicator "$model_tier")
    
    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}  PHASE: ${phase^^} │ Agent: $agent │ Model: $model_icon $model_tier │ #$attempt${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Dry run mode
    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}[DRY RUN] Would run phase: $phase${NC}"
        echo "  Agent: $agent"
        echo "  Model tier: $model_tier"
        echo "  Prompt: $(get_agent_prompt "$agent" | head -1)"
        return 0
    fi
    
    # Interactive mode
    if [ "$INTERACTIVE" = "true" ]; then
        read -p "Run $phase phase? [Y/n/s(kip)/q(uit)] " -n 1 -r
        echo ""
        case "$REPLY" in
            n|N|s|S) echo -e "${YELLOW}Skipped${NC}"; return 0 ;;
            q|Q) echo -e "${RED}Cancelled${NC}"; exit 1 ;;
        esac
    fi
    
    log "Phase $phase started (agent: $agent, model: $model_tier, attempt: $attempt)"
    track_cost "$model_tier"
    
    # Generate and run prompt
    local prompt=$(generate_phase_prompt "$phase")
    
    if timeout "${TIMEOUT_DEFAULT}" gh copilot suggest -t shell "$prompt" 2>&1; then
        log "Phase $phase completed"
        echo -e "${GREEN}✓ $phase complete${NC}"
        return 0
    else
        log "Phase $phase failed"
        
        # Escalate model tier on retry
        if [ "$attempt" -lt "$MAX_RETRIES" ]; then
            if [ "$model_tier" = "fast" ]; then
                echo -e "${YELLOW}Escalating to standard model...${NC}"
                MODEL_TIER=standard
            elif [ "$model_tier" = "standard" ]; then
                echo -e "${YELLOW}Escalating to premium model...${NC}"
                MODEL_TIER=premium
            fi
            run_phase "$phase" $((attempt + 1))
            return $?
        fi
        
        echo -e "${RED}✗ $phase failed after $attempt attempts${NC}"
        return 1
    fi
}

# === MAIN ===

main() {
    # Handle info flags
    [ "$SHOW_HELP" = "true" ] && print_usage && exit 0
    [ "$LIST_AGENTS" = "true" ] && list_agents && exit 0
    [ "$LIST_WORKFLOWS" = "true" ] && list_workflows && exit 0
    
    print_header
    
    # Validate inputs
    local phases=$(get_phases "$WORKFLOW")
    if [ -z "$phases" ]; then
        echo -e "${RED}Unknown workflow: $WORKFLOW${NC}"
        echo "Use --workflows to list available workflows"
        exit 1
    fi
    
    if [ -z "$TASK" ]; then
        echo -e "${RED}No task provided${NC}"
        print_usage
        exit 1
    fi
    
    # Display config
    echo -e "Task: ${CYAN}$TASK${NC}"
    echo -e "Workflow: ${CYAN}${CUSTOM_WORKFLOW:-$WORKFLOW}${NC}"
    echo -e "Phases: ${CYAN}$phases${NC}"
    [ -n "$CUSTOM_AGENT" ] && echo -e "Agent: ${CYAN}$CUSTOM_AGENT${NC}"
    [ "$DRY_RUN" = "true" ] && echo -e "Mode: ${YELLOW}DRY RUN${NC}"
    [ "$INTERACTIVE" = "true" ] && echo -e "Mode: ${YELLOW}INTERACTIVE${NC}"
    echo ""
    
    # Initialize handoff
    cat > "$HANDOFF_FILE" << EOF
# Orchestration Handoff
Task: $TASK
Workflow: ${CUSTOM_WORKFLOW:-$WORKFLOW}
Started: $(date)

## Status
Phase: starting

## Notes
EOF
    
    log "Starting: $TASK (workflow: $WORKFLOW)"
    local start_time=$(date +%s)
    local completed=0
    
    # Run phases
    for phase in $phases; do
        if run_phase "$phase"; then
            ((completed++))
        else
            echo ""
            echo -e "${RED}Failed at phase: $phase${NC}"
            echo -e "Resume with: ./orchestrate --resume $WORKFLOW \"$TASK\""
            exit 1
        fi
    done
    
    # Complete
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  ✓ COMPLETE │ Phases: $completed │ Time: $((duration/60))m $((duration%60))s${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    log "Completed in ${duration}s"
}

main
