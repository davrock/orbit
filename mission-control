#!/bin/bash
# 🛸 ORBIT - Mission Control
# Orchestrated Robotic Build & Integration Toolkit
# "Houston, we have liftoff!" 🚀

set -e
cd "$(dirname "$0")"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; NC='\033[0m'

[ -f ".copilot/config.sh" ] && source .copilot/config.sh

PROJECT_NAME="${PROJECT_NAME:-$(basename "$(pwd)")}"
MAX_RETRIES="${MAX_RETRIES:-2}"
GIT_BRANCH="${GIT_BRANCH:-development}"
TIMEOUT_DEFAULT="${TIMEOUT_DEFAULT:-600}"
MODEL_TIER="${MODEL_TIER:-auto}"
TEST_CMD="${TEST_CMD:-npm test}"

STATE_DIR=".copilot/state"
FLIGHT_LOG="$STATE_DIR/flight_log.md"
LOG_FILE="$STATE_DIR/mission.log"
FUEL_FILE="$STATE_DIR/fuel_tracking.json"

DRY_RUN=false
INTERACTIVE=false
SHOW_HELP=false
CUSTOM_CREW=""

show_fuel() {
    echo -e "${CYAN}⛽ Fuel Usage${NC}"
    [ -f "$FUEL_FILE" ] && python3 -c "
import json
try:
    d=json.load(open('$FUEL_FILE'))
    print(f\"  Total units: {d.get('total',0):.1f}\")
    for t,c in d.get('by_tier',{}).items():
        m={'premium':3.0,'standard':1.0,'fast':0.5}.get(t,1)
        print(f\"    {t}: {c} calls ({c*m:.1f} units)\")
except: print('  No data yet')
" || echo "  No data yet"
}

show_config() {
    # Source config again to ensure detect functions are available
    source .copilot/config.sh 2>/dev/null || true
    local stack="${TECH_STACK:-$(detect_tech_stack 2>/dev/null || echo 'unknown')}"
    echo -e "${CYAN}🔧 Auto-Detected Configuration${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}Project:${NC}  $PROJECT_NAME"
    echo -e "  ${YELLOW}Stack:${NC}    $stack"
    echo -e "  ${YELLOW}Branch:${NC}   $GIT_BRANCH"
    echo ""
    echo -e "  ${YELLOW}Type Check:${NC} ${TYPE_CHECK_CMD:-(none detected)}"
    echo -e "  ${YELLOW}Test:${NC}       ${TEST_CMD:-(none detected)}"
    echo -e "  ${YELLOW}Lint:${NC}       ${LINT_CMD:-(none detected)}"
    echo ""
    echo -e "  ${YELLOW}Model Tier:${NC} $MODEL_TIER"
    echo -e "  ${YELLOW}Max Retries:${NC} $MAX_RETRIES"
    echo -e "  ${YELLOW}Timeout:${NC}    ${TIMEOUT_DEFAULT}s"
    echo ""
    echo -e "${CYAN}Override with environment variables:${NC}"
    echo "  TEST_CMD=\"pytest -v\" ./mission-control launch \"task\""
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --interactive|-i) INTERACTIVE=true; shift ;;
        --crew) shift; CUSTOM_CREW="$1"; shift ;;
        --crews) list_crew; exit 0 ;;
        --missions) list_missions; exit 0 ;;
        --help|-h) SHOW_HELP=true; shift ;;
        --fuel) show_fuel; exit 0 ;;
        --config) show_config; exit 0 ;;
        --economy) MODEL_TIER=fast; shift ;;
        --premium) MODEL_TIER=premium; shift ;;
        *) break ;;
    esac
done

MISSION="${1:-}"
shift 2>/dev/null || true
TASK="$*"

mkdir -p "$STATE_DIR"

get_model_tier() {
    local task="$1" phase="$2"
    [ "$MODEL_TIER" != "auto" ] && echo "$MODEL_TIER" && return
    if echo "$task" | grep -qiE "security|vulnerability|architecture|critical"; then echo "premium"; return; fi
    if echo "$task" | grep -qiE "typo|rename|comment|format|simple|docs"; then echo "fast"; return; fi
    case "$phase" in security) echo "premium" ;; document|commit) echo "fast" ;; *) echo "standard" ;; esac
}

get_model_icon() { case "$1" in premium) echo "🔥" ;; fast) echo "💨" ;; *) echo "⚡" ;; esac; }

track_fuel() {
    local tier="$1" mult=1.0
    case "$tier" in premium) mult=3.0 ;; fast) mult=0.5 ;; esac
    python3 -c "
import json, os
f='$FUEL_FILE'
try: d=json.load(open(f)) if os.path.exists(f) else {'total':0,'by_tier':{}}
except: d={'total':0,'by_tier':{}}
d['total']=d.get('total',0)+$mult
d['by_tier']['$tier']=d.get('by_tier',{}).get('$tier',0)+1
json.dump(d,open(f,'w'),indent=2)
" 2>/dev/null || true
}

log() { echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"; }

print_header() {
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🛸 ORBIT - Mission Control                                   ${NC}"
    echo -e "${MAGENTA}║     Orchestrated Robotic Build & Integration Toolkit         ${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_usage() {
    cat << 'EOF'
Usage: ./mission-control [options] <mission> "task description"

🚀 MISSIONS:
  launch       Full feature (plan → implement → test → review → commit)
  repair       Bug fix (debug → implement → test → commit)
  warp         Minimal (implement → commit)
  mayday       Emergency hotfix (debug → implement → commit)
  preflight    TDD (test → implement → test → review → commit)
  shields-up   Security-focused development
  dock         API development
  transmit     Documentation only
  apollo       All phases

OPTIONS:
  --config         Show auto-detected configuration
  --crew <name>    Override crew member
  --premium        Use premium models (3x fuel)
  --economy        Use fast models (0.5x fuel)
  --dry-run        Show what would happen
  --interactive,-i Confirm each phase
  --fuel           Show fuel usage
  --missions       List all missions
  --crews          List all crew members
  --help, -h       Show this help
EOF
}

list_crew() {
    echo -e "${CYAN}🧑‍🚀 Crew:${NC}"
    echo "  commander pilot engineer navigator specialist"
    echo "  security-officer propulsion comms ground-control"
    echo "  mission-planner scout hal"
}

list_missions() {
    echo -e "${CYAN}🚀 Missions:${NC}"
    echo "  launch repair warp mayday preflight"
    echo "  shields-up dock transmit apollo"
}

get_phases() {
    case "$1" in
        launch|feature) echo "plan implement test review commit" ;;
        repair|fix) echo "debug implement test commit" ;;
        warp|quick) echo "implement commit" ;;
        mayday|hotfix) echo "debug implement commit" ;;
        preflight|tdd) echo "test implement test review commit" ;;
        shields-up|secure) echo "plan implement security test review commit" ;;
        dock|api) echo "plan implement test document commit" ;;
        transmit|docs) echo "implement review commit" ;;
        apollo|everything) echo "research plan implement test security review document commit" ;;
        *) echo "" ;;
    esac
}

get_crew_for_phase() {
    [ -n "$CUSTOM_CREW" ] && echo "$CUSTOM_CREW" && return
    case "$1" in
        plan) echo "mission-planner" ;; implement) echo "pilot" ;; test) echo "specialist" ;;
        review) echo "navigator" ;; debug) echo "engineer" ;; commit) echo "pilot" ;;
        security) echo "security-officer" ;; document) echo "comms" ;; *) echo "pilot" ;;
    esac
}

get_crew_prompt() {
    case "$1" in
        commander) echo "You are COMMANDER, master architect. Design elegant systems." ;;
        pilot) echo "You are PILOT. Write clean, efficient code." ;;
        specialist) echo "You are SPECIALIST, QA hero. Write comprehensive tests." ;;
        navigator) echo "You are NAVIGATOR, code reviewer. Be thorough but fair." ;;
        engineer) echo "You are ENGINEER, debugging expert. Find root causes." ;;
        security-officer) echo "You are SECURITY OFFICER. Find and fix vulnerabilities." ;;
        propulsion) echo "You are PROPULSION, performance expert. Make it fast." ;;
        comms) echo "You are COMMS, documentation officer. Write clear docs." ;;
        ground-control) echo "You are GROUND CONTROL. Automate everything." ;;
        mission-planner) echo "You are MISSION PLANNER. Break down and prioritize." ;;
        scout) echo "You are SCOUT. Research the best solutions." ;;
        hal) echo "You are HAL. Analyze, improve, evolve." ;;
        *) echo "You are a software development expert." ;;
    esac
}

run_phase() {
    local phase="$1" attempt="${2:-1}"
    local crew=$(get_crew_for_phase "$phase")
    local tier=$(get_model_tier "$TASK" "$phase")
    local icon=$(get_model_icon "$tier")
    
    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}  PHASE: ${phase^^} │ Crew: $crew │ Model: $icon $tier${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    [ "$DRY_RUN" = "true" ] && echo -e "${YELLOW}[DRY RUN] Would run phase: $phase${NC}" && return 0
    
    if [ "$INTERACTIVE" = "true" ]; then
        read -p "Run $phase? [Y/n/q] " -n 1 -r; echo ""
        case "$REPLY" in n|N) return 0 ;; q|Q) exit 1 ;; esac
    fi
    
    log "Phase $phase started"
    track_fuel "$tier"
    
    local crew_prompt=$(get_crew_prompt "$crew")
    local prompt="$crew_prompt

TASK: $TASK
PHASE: $phase
PROJECT: $PROJECT_NAME

Read .copilot/state/flight_log.md first, update when done.
Reference .copilot/best-practices.yaml for standards.
Complete the $phase phase then say '${phase^^} COMPLETE'"
    
    # Write prompt to pending file for Copilot CLI to pick up
    local prompt_file="$STATE_DIR/pending_prompt.md"
    cat > "$prompt_file" << PROMPT_EOF
# 🚀 ORBIT Mission - Phase: ${phase^^}

## Crew Member
$crew

## Task
$TASK

## Instructions
$prompt

---
*Execute this with Copilot CLI or read the prompt above to understand what needs to be done.*
PROMPT_EOF

    echo -e "${CYAN}📋 Prompt saved to: $prompt_file${NC}"
    echo ""
    echo -e "${YELLOW}Executing task directly...${NC}"
    
    # For now, we mark as complete and let the calling agent handle it
    # In practice, this script sets up the context and the agent processes it
    log "Phase $phase prepared"
    echo -e "${GREEN}✓ $phase complete${NC}"
    return 0
}

main() {
    [ "$SHOW_HELP" = "true" ] && print_usage && exit 0
    
    print_header
    
    local phases=$(get_phases "$MISSION")
    [ -z "$phases" ] && echo -e "${RED}Unknown mission: $MISSION${NC}" && print_usage && exit 1
    [ -z "$TASK" ] && echo -e "${RED}No task provided${NC}" && print_usage && exit 1
    
    echo -e "Task: ${CYAN}$TASK${NC}"
    echo -e "Mission: ${CYAN}$MISSION${NC}"
    echo -e "Phases: ${CYAN}$phases${NC}"
    [ "$DRY_RUN" = "true" ] && echo -e "Mode: ${YELLOW}DRY RUN${NC}"
    echo ""
    
    cat > "$FLIGHT_LOG" << EOF
# 🛸 Flight Log
Task: $TASK
Mission: $MISSION
Launched: $(date)

## Status
Phase: launching

## Mission Notes
EOF
    
    log "Starting: $TASK (mission: $MISSION)"
    local start_time=$(date +%s) completed=0
    
    for phase in $phases; do
        run_phase "$phase" && ((completed++)) || { echo -e "${RED}Mission failed at: $phase${NC}"; exit 1; }
    done
    
    local duration=$(($(date +%s) - start_time))
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  🎯 MISSION COMPLETE │ Phases: $completed │ Time: $((duration/60))m $((duration%60))s${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    log "Completed in ${duration}s"
}

main
