# .copilot/ is created by 'orbit deploy' in target projects, not used in ORBIT's own repo
# Exception: instructions.md is tracked for Copilot awareness
.copilot/*
!.copilot/instructions.md
queue_output.log

# Temporary files
/tmp/copilot_*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
npm-debug.log*
.node-version
.nvmrc

# Python (if testing in Python projects)
__pycache__/
*.py[cod]
.pytest_cache/
venv/

# Go (if testing in Go projects)
*.test
*.out

# Build artifacts (adapt to your needs)
dist/
build/
*.log
