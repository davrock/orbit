#!/bin/bash
# Monitor Orchestration Progress
# Shows real-time logs and status of autonomous feature processing

cd "$(dirname "$0")"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

print_header() {
    clear
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Orchestration Monitor${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

show_status() {
    print_header
    
    # Show queue status
    echo -e "${CYAN}=== Feature Queue Status ===${NC}"
    if [ -f ".copilot/feature_queue.txt" ]; then
        local total=$(grep "^[^#]" .copilot/feature_queue.txt | grep -v "^$" | wc -l)
        local completed=$(grep "^# ✓" .copilot/feature_queue.txt | wc -l)
        local remaining=$((total - completed))
        
        echo -e "Total features: ${BLUE}$total${NC}"
        echo -e "Completed: ${GREEN}$completed${NC}"
        echo -e "Remaining: ${YELLOW}$remaining${NC}"
    fi
    
    echo ""
    echo -e "${CYAN}=== Current Phase ===${NC}"
    if [ -f ".copilot/state/orchestration.log" ]; then
        tail -3 .copilot/state/orchestration.log | head -1
    else
        echo "No active orchestration"
    fi
    
    echo ""
    echo -e "${CYAN}=== Recent Activity (last 10 lines) ===${NC}"
    if [ -f ".copilot/state/orchestration.log" ]; then
        tail -10 .copilot/state/orchestration.log
    fi
    
    echo ""
    echo -e "${CYAN}=== Log Files ===${NC}"
    echo "Orchestration: .copilot/state/orchestration.log"
    echo "Queue: .copilot/queue_processor.log"
    echo "Handoff: .copilot/state/handoff.md"
    
    echo ""
    echo -e "${YELLOW}Press Ctrl+C to exit, or wait 5s for refresh...${NC}"
}

# Parse command
case "${1:-status}" in
    tail|follow|f)
        echo -e "${CYAN}Following orchestration log (Ctrl+C to exit)...${NC}"
        echo ""
        tail -f .copilot/state/orchestration.log 2>/dev/null || echo "No log file yet"
        ;;
    queue|q)
        echo -e "${CYAN}Following queue processor log (Ctrl+C to exit)...${NC}"
        echo ""
        tail -f .copilot/queue_processor.log 2>/dev/null || echo "No log file yet"
        ;;
    handoff|h)
        cat .copilot/state/handoff.md 2>/dev/null || echo "No handoff file yet"
        ;;
    watch|w)
        while true; do
            show_status
            sleep 5
        done
        ;;
    *)
        show_status
        ;;
esac
