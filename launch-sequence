#!/bin/bash
# 🚀 ORBIT - Launch Sequence
# Self-Improving AI System
# "Houston, we have a problem!" - Apollo 13

set -e
cd "$(dirname "$0")"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; NC='\033[0m'

LOOP_DELAY="${LOOP_DELAY:-120}"
MAX_ITERATIONS="${MAX_ITERATIONS:-0}"
STATE_DIR=".copilot/state"
GC_FILE="$STATE_DIR/ground_control.json"
LOG_FILE="$STATE_DIR/launch.log"
CARGO_FILE=".copilot/cargo_manifest.txt"

MAX_FAILS=3
MAX_NO_PROGRESS=5
MAX_SAME_TYPE=3

QUOTES=(
    "Houston, we have a problem!"
    "That's one small step for code, one giant leap for the project."
    "Space: the final frontier... of bugs."
    "To infinity and beyond!"
    "I'm sorry Dave, I can't let you merge that."
    "Ground control to Major Tom..."
)

mkdir -p "$STATE_DIR"

PLANS_DIR=".copilot/plans"

get_cargo_item() {
    [ -f "$CARGO_FILE" ] || return 1
    grep -v "^#" "$CARGO_FILE" | grep -v "^$" | head -1
}

get_github_issue() {
    command -v gh &>/dev/null || return 1
    gh repo view &>/dev/null 2>&1 || return 1
    gh issue list --state open --limit 1 --json number,title --jq '.[0] | "\(.number):\(.title)"' 2>/dev/null | grep -v null
}

get_pending_plan() {
    [ -d "$PLANS_DIR" ] || return 1
    for plan in "$PLANS_DIR"/*.md; do
        [ -f "$plan" ] || continue
        if grep -q "^# Status: ISSUES_CREATED" "$plan" 2>/dev/null; then
            basename "$plan" .md
            return 0
        fi
    done
    return 1
}

mark_delivered() {
    local item="$1" temp="${CARGO_FILE}.tmp"
    sed "s|^${item}$|# ✓ ${item} ($(date +%Y-%m-%d))|" "$CARGO_FILE" > "$temp" && mv "$temp" "$CARGO_FILE"
}

get_work() {
    local q=$(get_cargo_item) && echo "cargo:$q" && return 0
    local g=$(get_github_issue) && echo "github:$g" && return 0
    local p=$(get_pending_plan) && echo "plan:$p" && return 0
    echo "self:improve"
}

quote() { echo "${QUOTES[$RANDOM % ${#QUOTES[@]}]}"; }
log() { echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"; }

print_banner() {
    echo -e "${MAGENTA}"
    echo '    ╔═══════════════════════════════════════════════════════════╗'
    echo '    ║  🚀 ORBIT - Launch Sequence                               ║'
    echo '    ║     Self-Improving Development System                     ║'
    echo '    ╚═══════════════════════════════════════════════════════════╝'
    echo -e "${NC}"
}

show_help() {
    cat << 'EOF'
Usage: ./launch-sequence [options]

🚀 Self-improvement loop

OPTIONS:
  --once       Single cycle
  --status     Show history
  --reset      Clear state
  --turbo      Fast mode (30s delay)
  -h, --help   Show help

ENVIRONMENT:
  LOOP_DELAY=120      Seconds between cycles
  MAX_ITERATIONS=10   Stop after N (0=infinite)

FAILSAFES:
  ✓ Max 3 consecutive failures → cooldown
  ✓ Max 5 no-progress cycles → abort
  ✓ Detects stuck loops
EOF
}

show_status() {
    echo -e "${CYAN}🚀 Status${NC}"
    [ -f "$GC_FILE" ] && cat "$GC_FILE" || echo "No history. Run ./launch-sequence"
}

init_gc() { echo '{"fails":0,"no_progress":0,"types":[],"cycles":0,"successes":0}' > "$GC_FILE"; }

get_gc() { python3 -c "import json; print(json.load(open('$GC_FILE')).get('$1',0))" 2>/dev/null || echo "0"; }

record() {
    local success=$1 type="${2:-unknown}"
    python3 -c "
import json
d = json.load(open('$GC_FILE'))
if $success:
    d['fails'], d['no_progress'] = 0, 0
    d['successes'] = d.get('successes',0) + 1
    d['types'] = (d.get('types',[]) + ['$type'])[-$MAX_SAME_TYPE:]
else:
    d['fails'] = d.get('fails',0) + 1
    d['no_progress'] = d.get('no_progress',0) + 1
d['cycles'] = d.get('cycles',0) + 1
json.dump(d, open('$GC_FILE','w'))
" 2>/dev/null
}

check_gc() {
    local fails=$(get_gc fails) no_prog=$(get_gc no_progress)
    
    if [ "$fails" -ge "$MAX_FAILS" ]; then
        echo -e "${RED}🚨 GROUND CONTROL: $fails failures!${NC}"
        echo -e "${YELLOW}   \"$(quote)\"${NC}"
        echo -e "${YELLOW}   Cooling down 60s...${NC}"
        python3 -c "import json; d=json.load(open('$GC_FILE')); d['fails']=0; json.dump(d,open('$GC_FILE','w'))" 2>/dev/null
        sleep 60
        return 0
    fi
    
    if [ "$no_prog" -ge "$MAX_NO_PROGRESS" ]; then
        echo -e "${RED}🚨 GROUND CONTROL: No progress for $no_prog cycles!${NC}"
        echo -e "${YELLOW}   \"$(quote)\" - Aborting${NC}"
        return 1
    fi
    return 0
}

run_cycle() {
    local i=$1
    
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  🚀 Launch Cycle #$i${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    check_gc || return 2
    
    local work=$(get_work)
    local src="${work%%:*}" task="${work#*:}"
    
    case "$src" in
        cargo) echo -e "${CYAN}📦 Cargo: $task${NC}" ;;
        github) 
            local num="${task%%:*}" title="${task#*:}"
            echo -e "${CYAN}🐙 GitHub #$num: $title${NC}"
            task="Fix issue #$num: $title"
            ;;
        plan)
            echo -e "${CYAN}📐 Flight Plan: $task${NC}"
            if ./flight-plan execute "$task" 2>&1; then
                record true "plan"
                return 0
            else
                record false "plan_error"
                return 1
            fi
            ;;
        self) 
            echo -e "${CYAN}🔍 Self-Improvement${NC}"
            task="Analyze this project and implement ONE improvement. Focus on code quality, tests, or performance. Commit it."
            ;;
    esac
    
    local before=$(git rev-parse HEAD 2>/dev/null || echo "x")
    
    if timeout 600 ./mission-control launch "$task" 2>&1; then
        local after=$(git rev-parse HEAD 2>/dev/null || echo "x")
        
        if [ "$before" != "$after" ]; then
            local msg=$(git log -1 --pretty=%B 2>/dev/null | head -1)
            echo -e "${GREEN}✓ Success: $msg${NC}"
            [ "$src" = "cargo" ] && mark_delivered "$task"
            [ "$src" = "github" ] && gh issue close "${task%%:*}" --comment "Fixed by ORBIT" 2>/dev/null || true
            record true "$src"
            log "Cycle $i [$src]: $msg"
            return 0
        else
            echo -e "${YELLOW}⚠ No changes${NC}"
            record false "no_change"
            return 1
        fi
    else
        echo -e "${RED}✗ Failed${NC}"
        record false "error"
        return 1
    fi
}

main() {
    local once=false
    
    while [ $# -gt 0 ]; do
        case "$1" in
            --once) once=true ;;
            --status) show_status; exit 0 ;;
            --reset) init_gc; echo "Reset."; exit 0 ;;
            --turbo) LOOP_DELAY=30 ;;
            -h|--help) show_help; exit 0 ;;
        esac
        shift
    done
    
    print_banner
    [ ! -f "$GC_FILE" ] && init_gc
    
    echo -e "Mode: ${CYAN}$([ "$once" = "true" ] && echo "Single" || echo "Continuous")${NC}"
    [ "$MAX_ITERATIONS" -gt 0 ] && echo -e "Max: ${CYAN}$MAX_ITERATIONS${NC}"
    echo -e "Delay: ${CYAN}${LOOP_DELAY}s${NC}"
    echo -e "Ground Control: ${GREEN}ACTIVE${NC}"
    echo ""
    echo -e "${YELLOW}Ctrl+C to abort${NC}"
    
    log "Launch sequence initiated"
    
    local i=0
    while true; do
        ((i++))
        [ "$MAX_ITERATIONS" -gt 0 ] && [ "$i" -gt "$MAX_ITERATIONS" ] && break
        
        local result=0
        run_cycle "$i" || result=$?
        
        [ "$result" -eq 2 ] && break
        [ "$once" = "true" ] && break
        
        echo -e "${CYAN}💫 Next in ${LOOP_DELAY}s...${NC}"
        sleep "$LOOP_DELAY"
    done
    
    local s=$(get_gc successes) c=$(get_gc cycles)
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  🎯 Complete: $c cycles, $s improvements${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    log "Complete: $c cycles, $s improvements"
}

trap 'echo -e "\n${YELLOW}🛑 Aborted${NC}"; exit 0' INT TERM
main "$@"
