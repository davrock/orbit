#!/bin/bash
# 🛸 ORBIT - Flight Plan Generator
# Creates detailed implementation plans from feature descriptions
# Like BMAD but focused: Plan → Issues → Execute

set -e
cd "$(dirname "$0")"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; NC='\033[0m'

STATE_DIR=".copilot/state"
PLANS_DIR=".copilot/plans"
TEMPLATES_DIR=".copilot/templates"

mkdir -p "$STATE_DIR" "$PLANS_DIR" "$TEMPLATES_DIR"

show_help() {
    cat << 'EOF'
🛸 ORBIT Flight Plan - Implementation Planning

Usage: ./flight-plan <command> [options]

COMMANDS:
  new "feature"       Generate a new implementation plan
  list                List all plans
  show <plan-id>      Display a specific plan
  issues <plan-id>    Generate GitHub issues from plan
  execute <plan-id>   Execute plan tasks via mission-control

OPTIONS:
  --depth <1-3>       Planning depth (1=quick, 2=standard, 3=detailed)
  --no-issues         Skip GitHub issue generation
  --dry-run           Show what would happen

EXAMPLES:
  ./flight-plan new "Add user authentication with OAuth"
  ./flight-plan new "Refactor database layer" --depth 3
  ./flight-plan issues plan-001
  ./flight-plan execute plan-001
EOF
}

generate_plan_id() {
    local count=$(ls -1 "$PLANS_DIR" 2>/dev/null | wc -l)
    printf "plan-%03d" $((count + 1))
}

create_plan_template() {
    cat << 'EOF'
# 🛸 Flight Plan: {{TITLE}}
# Generated: {{DATE}}
# ID: {{PLAN_ID}}
# Status: DRAFT

## 🎯 Objective
{{OBJECTIVE}}

## 📋 Requirements
- [ ] Requirement 1
- [ ] Requirement 2

## 🏗️ Architecture Decisions
<!-- Key technical decisions and rationale -->

## 📦 Components
<!-- Major components/modules affected -->

## 🔄 Implementation Phases

### Phase 1: Foundation
- [ ] Task 1.1: Description
- [ ] Task 1.2: Description

### Phase 2: Core Implementation
- [ ] Task 2.1: Description
- [ ] Task 2.2: Description

### Phase 3: Integration & Testing
- [ ] Task 3.1: Description
- [ ] Task 3.2: Description

## 🧪 Testing Strategy
- Unit tests:
- Integration tests:
- E2E tests:

## 📚 Documentation Updates
- [ ] README updates
- [ ] API documentation
- [ ] User guides

## ⚠️ Risks & Mitigations
| Risk | Impact | Mitigation |
|------|--------|------------|
|      |        |            |

## 📊 Estimation
- Complexity: [LOW/MEDIUM/HIGH]
- Estimated phases: X
- Estimated tasks: Y

## 🔗 Dependencies
- External:
- Internal:

---
*Generated by ORBIT Flight Plan*
EOF
}

new_plan() {
    local feature="$1"
    local depth="${DEPTH:-2}"
    local plan_id=$(generate_plan_id)
    local plan_file="$PLANS_DIR/${plan_id}.md"
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🛸 ORBIT - Flight Plan Generator                            ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "Feature: ${CYAN}$feature${NC}"
    echo -e "Plan ID: ${CYAN}$plan_id${NC}"
    echo -e "Depth: ${CYAN}$depth${NC}"
    echo ""
    
    # Create initial plan structure
    local template=$(create_plan_template)
    template="${template//\{\{TITLE\}\}/$feature}"
    template="${template//\{\{DATE\}\}/$(date '+%Y-%m-%d %H:%M')}"
    template="${template//\{\{PLAN_ID\}\}/$plan_id}"
    template="${template//\{\{OBJECTIVE\}\}/$feature}"
    
    echo "$template" > "$plan_file"
    
    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}[DRY RUN] Would generate plan${NC}"
        return 0
    fi
    
    echo -e "${CYAN}📋 Generating detailed plan...${NC}"
    
    local depth_prompt=""
    case "$depth" in
        1) depth_prompt="Create a quick, high-level plan with 3-5 main tasks." ;;
        2) depth_prompt="Create a standard plan with phases, 8-12 tasks, and key decisions." ;;
        3) depth_prompt="Create a comprehensive plan with detailed phases, 15+ tasks, architecture decisions, risks, and testing strategy." ;;
    esac
    
    local prompt="You are MISSION PLANNER, an expert at breaking down features into actionable implementation plans.

FEATURE REQUEST: $feature

$depth_prompt

Read the existing plan template at $plan_file and fill it in with:
1. Clear, specific requirements extracted from the feature
2. Architecture decisions with rationale
3. Implementation phases with concrete tasks
4. Each task should be small enough to complete in one session
5. Testing strategy appropriate for the feature
6. Risks and mitigations

Update $plan_file with the complete plan. Be specific, not generic.
Reference the project's existing patterns and structure.
When done, say 'FLIGHT PLAN COMPLETE' and /exit"

    if timeout 300 gh copilot suggest -t shell "$prompt" 2>&1; then
        echo ""
        echo -e "${GREEN}✓ Flight plan generated: $plan_file${NC}"
        echo ""
        
        if [ "$NO_ISSUES" != "true" ]; then
            read -p "Generate GitHub issues from this plan? [Y/n] " -n 1 -r
            echo ""
            [[ ! $REPLY =~ ^[Nn]$ ]] && generate_issues "$plan_id"
        fi
    else
        echo -e "${RED}✗ Failed to generate plan${NC}"
        return 1
    fi
}

list_plans() {
    echo -e "${CYAN}📋 Flight Plans${NC}"
    echo ""
    
    if [ ! -d "$PLANS_DIR" ] || [ -z "$(ls -A "$PLANS_DIR" 2>/dev/null)" ]; then
        echo "  No plans yet. Create one with: ./flight-plan new \"feature\""
        return 0
    fi
    
    for plan in "$PLANS_DIR"/*.md; do
        local id=$(basename "$plan" .md)
        local title=$(grep "^# 🛸 Flight Plan:" "$plan" | sed 's/^# 🛸 Flight Plan: //')
        local status=$(grep "^# Status:" "$plan" | sed 's/^# Status: //')
        echo -e "  ${CYAN}$id${NC}: $title [$status]"
    done
}

show_plan() {
    local plan_id="$1"
    local plan_file="$PLANS_DIR/${plan_id}.md"
    
    if [ ! -f "$plan_file" ]; then
        echo -e "${RED}Plan not found: $plan_id${NC}"
        return 1
    fi
    
    cat "$plan_file"
}

generate_issues() {
    local plan_id="$1"
    local plan_file="$PLANS_DIR/${plan_id}.md"
    
    if [ ! -f "$plan_file" ]; then
        echo -e "${RED}Plan not found: $plan_id${NC}"
        return 1
    fi
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🐙 ORBIT - Issue Transmitter                                ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "Plan: ${CYAN}$plan_id${NC}"
    echo ""
    
    if ! command -v gh &>/dev/null; then
        echo -e "${RED}GitHub CLI (gh) not installed${NC}"
        return 1
    fi
    
    if ! gh repo view &>/dev/null 2>&1; then
        echo -e "${RED}Not in a GitHub repository${NC}"
        return 1
    fi
    
    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}[DRY RUN] Would generate issues from plan${NC}"
        return 0
    fi
    
    local prompt="You are COMMS OFFICER, expert at creating clear GitHub issues.

Read the flight plan at $plan_file and create GitHub issues for each task.

For each task in the plan:
1. Create a GitHub issue using: gh issue create --title \"TITLE\" --body \"BODY\" --label \"LABEL\"
2. Title format: \"[PLAN_ID] Task: Description\"
3. Body should include:
   - Context from the plan
   - Acceptance criteria
   - Related tasks (by task number)
4. Use appropriate labels: enhancement, bug, documentation, testing
5. Link issues that depend on each other

Create the parent epic issue first, then child task issues.
When done, list all created issue numbers and say 'ISSUES TRANSMITTED' and /exit"

    if timeout 300 gh copilot suggest -t shell "$prompt" 2>&1; then
        echo ""
        echo -e "${GREEN}✓ GitHub issues created${NC}"
        
        # Update plan status
        sed -i 's/^# Status: DRAFT/# Status: ISSUES_CREATED/' "$plan_file"
    else
        echo -e "${RED}✗ Failed to create issues${NC}"
        return 1
    fi
}

execute_plan() {
    local plan_id="$1"
    local plan_file="$PLANS_DIR/${plan_id}.md"
    
    if [ ! -f "$plan_file" ]; then
        echo -e "${RED}Plan not found: $plan_id${NC}"
        return 1
    fi
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🚀 ORBIT - Plan Executor                                    ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "Plan: ${CYAN}$plan_id${NC}"
    echo ""
    
    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}[DRY RUN] Would execute plan tasks${NC}"
        return 0
    fi
    
    # Extract tasks from plan and execute them
    local prompt="You are GROUND CONTROL, orchestrating plan execution.

Read the flight plan at $plan_file.

For each uncompleted task (- [ ]):
1. Execute it using: ./mission-control warp \"task description\"
2. If successful, mark the task complete in the plan (- [x])
3. Continue to the next task
4. If a task fails, stop and report the issue

Execute tasks in order, respecting dependencies.
After each task, update the plan file.
When all tasks complete, update status to COMPLETE.
Say 'PLAN EXECUTED' and /exit when done."

    if timeout 1800 gh copilot suggest -t shell "$prompt" 2>&1; then
        echo ""
        echo -e "${GREEN}✓ Plan execution complete${NC}"
        sed -i 's/^# Status: .*/# Status: COMPLETE/' "$plan_file"
    else
        echo -e "${RED}✗ Plan execution failed${NC}"
        sed -i 's/^# Status: .*/# Status: FAILED/' "$plan_file"
        return 1
    fi
}

# Parse global options
DRY_RUN=false
NO_ISSUES=false
DEPTH=2

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --no-issues) NO_ISSUES=true; shift ;;
        --depth) shift; DEPTH="$1"; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) break ;;
    esac
done

COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    new) new_plan "$*" ;;
    list) list_plans ;;
    show) show_plan "$1" ;;
    issues) generate_issues "$1" ;;
    execute) execute_plan "$1" ;;
    "") show_help ;;
    *) echo -e "${RED}Unknown command: $COMMAND${NC}"; show_help; exit 1 ;;
esac
