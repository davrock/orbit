#!/bin/bash
# 🛸 ORBIT - Issue Transmitter
# Convert tasks, plans, or queue items into GitHub issues
# Standalone or integrated with flight-plan

set -e
cd "$(dirname "$0")"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; NC='\033[0m'

CARGO_FILE=".copilot/cargo_manifest.txt"
PLANS_DIR=".copilot/plans"
STATE_DIR=".copilot/state"
ISSUES_LOG="$STATE_DIR/issues_created.log"

mkdir -p "$STATE_DIR"

show_help() {
    cat << 'EOF'
🛸 ORBIT Issue Transmitter - GitHub Issue Generator

Usage: ./transmit-issues <command> [options]

COMMANDS:
  from-cargo          Create issues from cargo manifest
  from-plan <id>      Create issues from a flight plan
  from-text "desc"    Create a single issue from description
  bulk <file>         Create issues from a text file (one per line)
  templates           Show issue templates
  log                 Show created issues log

OPTIONS:
  --labels <l1,l2>    Add labels (comma-separated)
  --milestone <name>  Add to milestone
  --assignee <user>   Assign to user
  --project <name>    Add to project
  --epic              Create as epic with sub-issues
  --dry-run           Preview without creating

EXAMPLES:
  ./transmit-issues from-cargo
  ./transmit-issues from-plan plan-001
  ./transmit-issues from-text "Add dark mode support" --labels enhancement
  ./transmit-issues bulk ./features.txt --milestone v2.0
EOF
}

check_gh() {
    if ! command -v gh &>/dev/null; then
        echo -e "${RED}GitHub CLI (gh) not installed${NC}"
        echo "Install: https://cli.github.com/"
        exit 1
    fi
    
    if ! gh auth status &>/dev/null 2>&1; then
        echo -e "${RED}Not authenticated with GitHub${NC}"
        echo "Run: gh auth login"
        exit 1
    fi
    
    if ! gh repo view &>/dev/null 2>&1; then
        echo -e "${RED}Not in a GitHub repository${NC}"
        exit 1
    fi
}

log_issue() {
    local num="$1" title="$2" source="$3"
    echo "[$(date '+%Y-%m-%d %H:%M')] #$num: $title (from: $source)" >> "$ISSUES_LOG"
}

create_issue() {
    local title="$1"
    local body="$2"
    local source="${3:-manual}"
    
    local cmd="gh issue create --title \"$title\""
    
    [ -n "$body" ] && cmd="$cmd --body \"$body\""
    [ -n "$LABELS" ] && cmd="$cmd --label \"$LABELS\""
    [ -n "$MILESTONE" ] && cmd="$cmd --milestone \"$MILESTONE\""
    [ -n "$ASSIGNEE" ] && cmd="$cmd --assignee \"$ASSIGNEE\""
    
    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}[DRY RUN] Would create: $title${NC}"
        return 0
    fi
    
    echo -e "${CYAN}Creating issue: $title${NC}"
    
    local result
    if result=$(eval "$cmd" 2>&1); then
        local num=$(echo "$result" | grep -oE '[0-9]+$')
        echo -e "${GREEN}✓ Created #$num${NC}"
        log_issue "$num" "$title" "$source"
        
        # Add to project if specified
        if [ -n "$PROJECT" ]; then
            gh issue edit "$num" --add-project "$PROJECT" 2>/dev/null || true
        fi
        
        echo "$num"
    else
        echo -e "${RED}✗ Failed: $result${NC}"
        return 1
    fi
}

generate_issue_body() {
    local title="$1"
    local context="$2"
    
    cat << EOF
## 📋 Description
$title

## 🎯 Objective
<!-- What should be accomplished -->

## ✅ Acceptance Criteria
- [ ] Criteria 1
- [ ] Criteria 2
- [ ] Tests pass
- [ ] Documentation updated

## 📝 Context
$context

## 🔗 Related
<!-- Link related issues/PRs -->

---
*Generated by ORBIT Issue Transmitter*
EOF
}

from_cargo() {
    check_gh
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🐙 ORBIT - Cargo to Issues                                  ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    if [ ! -f "$CARGO_FILE" ]; then
        echo -e "${YELLOW}No cargo manifest found${NC}"
        return 0
    fi
    
    local count=0
    local priority=""
    
    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        [[ "$line" =~ ^#\ ✓ ]] && continue
        
        if [[ "$line" =~ ^#\ HIGH ]]; then
            priority="high"
            LABELS="${LABELS:+$LABELS,}priority:high"
            continue
        elif [[ "$line" =~ ^#\ MEDIUM ]]; then
            priority="medium"
            LABELS="${LABELS:+$LABELS,}priority:medium"
            continue
        elif [[ "$line" =~ ^#\ LOW ]]; then
            priority="low"
            LABELS="${LABELS:+$LABELS,}priority:low"
            continue
        elif [[ "$line" =~ ^# ]]; then
            continue
        fi
        
        local body=$(generate_issue_body "$line" "From cargo manifest ($priority priority)")
        create_issue "$line" "$body" "cargo" && ((count++))
        
    done < "$CARGO_FILE"
    
    echo ""
    echo -e "${GREEN}Created $count issues from cargo${NC}"
}

from_plan() {
    local plan_id="$1"
    local plan_file="$PLANS_DIR/${plan_id}.md"
    
    check_gh
    
    if [ ! -f "$plan_file" ]; then
        echo -e "${RED}Plan not found: $plan_id${NC}"
        return 1
    fi
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🐙 ORBIT - Plan to Issues                                   ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "Plan: ${CYAN}$plan_id${NC}"
    echo ""
    
    local title=$(grep "^# 🛸 Flight Plan:" "$plan_file" | sed 's/^# 🛸 Flight Plan: //')
    
    if [ "$EPIC" = "true" ]; then
        # Create epic first
        local epic_body="# Epic: $title\n\nSee flight plan: $plan_id\n\n## Tasks\n"
        local epic_num=$(create_issue "[Epic] $title" "$epic_body" "plan-$plan_id")
        echo ""
    fi
    
    local count=0
    local phase=""
    
    while IFS= read -r line; do
        # Track phases
        if [[ "$line" =~ ^###\ Phase ]]; then
            phase=$(echo "$line" | sed 's/^### //')
            continue
        fi
        
        # Extract tasks (unchecked checkboxes)
        if [[ "$line" =~ ^-\ \[\ \]\ (.+)$ ]]; then
            local task="${BASH_REMATCH[1]}"
            local task_title="[$plan_id] $task"
            local task_body=$(generate_issue_body "$task" "Phase: $phase\nPlan: $plan_id")
            
            local num=$(create_issue "$task_title" "$task_body" "plan-$plan_id")
            
            # Link to epic if created
            if [ -n "$epic_num" ] && [ -n "$num" ]; then
                gh issue edit "$epic_num" --body "$(gh issue view "$epic_num" --json body -q .body)\n- #$num" 2>/dev/null || true
            fi
            
            ((count++))
        fi
        
    done < "$plan_file"
    
    echo ""
    echo -e "${GREEN}Created $count issues from plan${NC}"
    
    # Update plan status
    [ "$DRY_RUN" != "true" ] && sed -i 's/^# Status: .*/# Status: ISSUES_CREATED/' "$plan_file"
}

from_text() {
    local description="$1"
    
    check_gh
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🐙 ORBIT - Quick Issue                                      ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    # Use AI to enhance the issue description
    local prompt="Create a well-structured GitHub issue from this description:

$description

Generate:
1. A clear, concise title (max 80 chars)
2. A detailed body with:
   - Description
   - Acceptance criteria (3-5 items)
   - Any technical considerations

Output format:
TITLE: <title>
BODY:
<body content>
"
    
    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}[DRY RUN] Would create issue for: $description${NC}"
        return 0
    fi
    
    local body=$(generate_issue_body "$description" "Created from quick issue command")
    create_issue "$description" "$body" "text"
}

bulk_create() {
    local file="$1"
    
    check_gh
    
    if [ ! -f "$file" ]; then
        echo -e "${RED}File not found: $file${NC}"
        return 1
    fi
    
    echo -e "${MAGENTA}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${MAGENTA}║  🐙 ORBIT - Bulk Issue Creator                               ║${NC}"
    echo -e "${MAGENTA}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "File: ${CYAN}$file${NC}"
    echo ""
    
    local count=0
    
    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        [[ "$line" =~ ^# ]] && continue
        
        local body=$(generate_issue_body "$line" "Bulk import from $file")
        create_issue "$line" "$body" "bulk" && ((count++))
        
    done < "$file"
    
    echo ""
    echo -e "${GREEN}Created $count issues${NC}"
}

show_templates() {
    cat << 'EOF'
📋 Issue Templates

BUG:
  Title: [Bug] Brief description
  Labels: bug
  Body: Steps to reproduce, expected vs actual

FEATURE:
  Title: [Feature] Brief description
  Labels: enhancement
  Body: User story, acceptance criteria

DOCS:
  Title: [Docs] Brief description
  Labels: documentation
  Body: What needs documenting, where

REFACTOR:
  Title: [Refactor] Brief description
  Labels: refactor, technical-debt
  Body: Current state, proposed changes, benefits

EPIC:
  Title: [Epic] Brief description
  Labels: epic
  Body: Overview, list of sub-issues
EOF
}

show_log() {
    echo -e "${CYAN}📋 Issues Created Log${NC}"
    echo ""
    
    if [ ! -f "$ISSUES_LOG" ]; then
        echo "No issues created yet."
        return 0
    fi
    
    tail -20 "$ISSUES_LOG"
}

# Parse options
DRY_RUN=false
EPIC=false
LABELS=""
MILESTONE=""
ASSIGNEE=""
PROJECT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --epic) EPIC=true; shift ;;
        --labels) shift; LABELS="$1"; shift ;;
        --milestone) shift; MILESTONE="$1"; shift ;;
        --assignee) shift; ASSIGNEE="$1"; shift ;;
        --project) shift; PROJECT="$1"; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) break ;;
    esac
done

COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    from-cargo) from_cargo ;;
    from-plan) from_plan "$1" ;;
    from-text) from_text "$*" ;;
    bulk) bulk_create "$1" ;;
    templates) show_templates ;;
    log) show_log ;;
    "") show_help ;;
    *) echo -e "${RED}Unknown command: $COMMAND${NC}"; show_help; exit 1 ;;
esac
