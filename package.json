{
  "name": "@davrock/orbit",
  "version": "1.0.0",
  "description": "🛸 ORBIT - Orchestrated Robotic Build & Integration Toolkit. AI-powered autonomous software development.",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "orbit": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "README.zh.md",
    "README.ja.md",
    "README.es.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js 2>/dev/null || true",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/cli/postinstall.js 2>/dev/null || true"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davrock/orbit.git"
  },
  "keywords": [
    "ai",
    "automation",
    "development",
    "orchestration",
    "copilot",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davrock/orbit/issues"
  },
  "homepage": "https://github.com/davrock/orbit#readme",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
