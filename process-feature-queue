#!/bin/bash
# Feature Queue Processor - Fully Autonomous
# Processes features ONE AT A TIME using v5 orchestrator
# NO USER INPUT REQUIRED - runs completely autonomously

cd "$(dirname "$0")"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

QUEUE_FILE=".copilot/feature_queue.txt"
LOG_FILE=".copilot/queue_processor.log"

print_header() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Feature Queue Processor (Autonomous)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

init_queue() {
    mkdir -p .copilot
    
    if [ ! -f "$QUEUE_FILE" ]; then
        cat > "$QUEUE_FILE" << 'EOF'
# Feature Queue (one per line)
# Process with: ./process-feature-queue

# High Priority
Training Load & Fatigue Tracking
AI Coaching Suggestions

# Medium Priority
Race Calendar Integration
Social Run Matching
Group Admin Controls

# Lower Priority
Nutrition Tracking Integration
Voice Commands During Runs
Additional Languages
EOF
        echo -e "${YELLOW}Created initial queue: $QUEUE_FILE${NC}"
        echo "Edit this file to customize your feature list."
        exit 0
    fi
}

get_next_feature() {
    # Get first non-empty, non-comment line
    grep -v "^#" "$QUEUE_FILE" | grep -v "^$" | head -1
}

mark_feature_done() {
    local feature="$1"
    # Use a temp file approach to avoid sed regex issues with special characters
    local temp_file="${QUEUE_FILE}.tmp"
    local found=0
    
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$feature" ]] && [[ $found -eq 0 ]]; then
            echo "# ✓ $feature (completed $(date +%Y-%m-%d))"
            found=1
        else
            echo "$line"
        fi
    done < "$QUEUE_FILE" > "$temp_file"
    
    mv "$temp_file" "$QUEUE_FILE"
}

remove_feature_from_queue() {
    local feature="$1"
    # Remove the feature line entirely from the queue
    local temp_file="${QUEUE_FILE}.tmp"
    
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" != "$feature" ]]; then
            echo "$line"
        fi
    done < "$QUEUE_FILE" > "$temp_file"
    
    mv "$temp_file" "$QUEUE_FILE"
    echo -e "${CYAN}Removed from queue: $feature${NC}"
}

process_feature() {
    local feature="$1"
    
    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}  Processing: $feature${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Run orchestrator
    ./orchestrate feature "$feature"
    
    local exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
        echo ""
        echo -e "${GREEN}✓ Feature completed: $feature${NC}"
        remove_feature_from_queue "$feature"
        return 0
    elif [ $exit_code -eq 2 ]; then
        # Exit code 2 means already implemented - remove from queue and continue
        echo ""
        echo -e "${YELLOW}✓ Feature already exists: $feature${NC}"
        remove_feature_from_queue "$feature"
        return 0
    else
        echo ""
        echo -e "${RED}✗ Feature had issues: $feature${NC}"
        return 1
    fi
}

show_queue() {
    echo -e "${CYAN}Current Queue:${NC}"
    echo ""
    
    local count=0
    while IFS= read -r line; do
        if [[ "$line" =~ ^[^#] ]] && [ -n "$line" ]; then
            count=$((count + 1))
            echo "  $count. $line"
        fi
    done < "$QUEUE_FILE"
    
    if [ $count -eq 0 ]; then
        echo -e "${GREEN}  Queue is empty! All features completed.${NC}"
        return 1
    fi
    
    echo ""
    return 0
}

main() {
    print_header
    
    init_queue
    
    if ! show_queue; then
        exit 0
    fi
    
    echo -e "${YELLOW}Processing features autonomously (no user input)...${NC}"
    echo -e "${CYAN}Log: $LOG_FILE${NC}"
    echo ""
    
    # Initialize log
    echo "=== Queue Processing Started ===" > "$LOG_FILE"
    echo "Started: $(date)" >> "$LOG_FILE"
    echo "" >> "$LOG_FILE"
    
    local processed=0
    local failed=0
    local start_time=$(date +%s)
    
    while true; do
        local feature
        feature=$(get_next_feature)
        
        if [ -z "$feature" ]; then
            echo ""
            echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${GREEN}  All features processed!${NC}"
            echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo ""
            echo "Completed: $processed"
            echo "Failed: $failed"
            break
        fi
        
        if process_feature "$feature"; then
            processed=$((processed + 1))
            echo "[$(date '+%H:%M:%S')] ✓ $feature" >> "$LOG_FILE"
        else
            failed=$((failed + 1))
            echo "[$(date '+%H:%M:%S')] ✗ $feature (failed)" >> "$LOG_FILE"
            # Continue to next feature automatically - no user input
            echo -e "${YELLOW}Feature failed, continuing to next...${NC}"
        fi
        
        echo ""
        echo -e "${BLUE}Moving to next feature automatically...${NC}"
        sleep 3
    done
    
    # Final summary
    echo "" >> "$LOG_FILE"
    echo "=== Queue Complete ===" >> "$LOG_FILE"
    echo "Completed: $processed, Failed: $failed" >> "$LOG_FILE"
}

main
